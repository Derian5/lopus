[resource]
script = ExtResource("1")
price = 250
upgrades_ability_id = &"ability.warrior_professionalism_bloodthirst_tier_1"
presentation_icon = ExtResource("icon")
id = &"ability.warrior_professionalism_bloodthirst_tier_2"
display_name = "Bloodthirst II"
description = "Basic attacks [heal]heal for {e0.lifesteal_percent}%[/heal] of the damage dealt and [debuff]shred {e1.status.stat_modifiers.0.value:abs} armor[/debuff] for {e1.status.default_duration}s, stacking up to {e1.status.max_stacks} times on a target (up to [debuff]-{e1.status.stat_modifiers.0.value*e1.status.max_stacks:abs} armor[/debuff]). All Warriors share the stacks."
kind = 1
targeting_policy = 0
delivery_method = 0
effects = Array[AbilityEffect]([SubResource("Lifesteal"), SubResource("Sunder")])
presentation_color = Color(0.86, 0.2, 0.18, 1)
presentation_text = "Bloodthirst"
available_to_heroes = false
presentation_style = &"drain"
tags = Array[StringName]([&"ability", &"passive", &"job", &"warrior", &"lifesteal", &"armor_shred"])
