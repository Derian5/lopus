[sub_resource type="Resource" id="AttackSpeedModifier"]
script = ExtResource("3")
stat = "attack_speed"
operation = 1
value = 1.5

[sub_resource type="Resource" id="AttackSpeedEffect"]
script = ExtResource("2")
effect_id = &"effect.massive_ogre_rage_attack_speed"
