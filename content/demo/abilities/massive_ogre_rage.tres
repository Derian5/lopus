duration = 6.0

[resource]
script = ExtResource("1")
id = &"ability.massive_ogre_rage"
display_name = "Massive Bloodrage"
description = "For 6 seconds, gains 50% attack speed, 50% basic-attack lifesteal, and 50% model and collision size."
cooldown_seconds = 15.0
targeting_policy = 0
delivery_method = 0
effects = Array[AbilityEffect]([SubResource("AttackSpeedEffect"), SubResource("EmpowermentEffect")])
priority = 100
presentation_color = Color(0.76, 0.18, 0.12, 1)
presentation_text = "Massive Bloodrage"
available_to_heroes = false
tags = Array[StringName]([&"ability", &"active", &"self_buff", &"enemy"])
