[resource]
script = ExtResource("1")
presentation_icon = ExtResource("generated_icon")
id = &"ability.envy_dart_volley"
display_name = "Jealous Barbs"
description = "Throws darts at up to {e0.max_targets} random enemies. Each dart [dmg]poisons for {e0.damage} damage per second[/dmg] and [cc]slows movement by {e0.movement_slow_percent}%[/cc] until the battle ends. Does not stack."
