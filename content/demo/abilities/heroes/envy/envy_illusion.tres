[resource]
script = ExtResource("1")
presentation_icon = ExtResource("generated_icon")
id = &"ability.envy_illusion"
display_name = "Perfect Imitation"
description = "Creates an allied [summon]illusion[/summon] of the strongest non-boss enemy with [summon]{e0.stat_percent}% of its stats[/summon] and its move speed. Lasts until the battle ends and uses basic attacks only."
cooldown_seconds = 10.0
targeting_policy = 0
effects = Array[AbilityEffect]([SubResource("Base")])
priority = 120
presentation_color = Color(0.45, 1, 0.55, 1)
presentation_style = &"summon"
allowed_hero_ids = Array[StringName]([&"hero.army_support"])
hero_levels = Array[AbilityLevelDefinition]([SubResource("L1"), SubResource("L2"), SubResource("L3"), SubResource("L4")])
tags = Array[StringName]([&"ability", &"active", &"envy", &"summon"])
