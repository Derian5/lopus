[resource]
script = ExtResource("1")
presentation_icon = ExtResource("generated_icon")
id = &"ability.wrath_threshold_guard"
display_name = "Too Angry to Fall"
description = "At {e0.health_threshold:pct}% HP, gains a [shield]shield of {e0.shield_max_hp_multiplier:pct}% Max HP[/shield] and [buff]+{e0.armor_multiplier:bonus_pct}% armor[/buff] for {e0.duration}s. Recharges after {e0.cooldown_seconds}s."
