display_name = "Cataclysmic Leap"
description = "Leaps to the nearest enemy within {search} and deals [dmg]{e0.damage} damage[/dmg]. Other enemies within {e0.impact_radius} are [cc]knocked back {e0.knockback_distance} and stunned for {e0.stun_duration}s[/cc]."
