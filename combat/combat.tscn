[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://combat/combat.gd" id="1_combat"]
[ext_resource type="PackedScene" path="res://combat/combat_session.tscn" id="2_session"]
[ext_resource type="PackedScene" path="res://ui/post_battle/post_battle_panel.tscn" id="3_post_battle"]
[ext_resource type="PackedScene" path="res://ui/combat/combat_statistics_panel.tscn" id="4_statistics"]
[ext_resource type="PackedScene" path="res://ui/combat/selected_unit_panel.tscn" id="5_selected"]

[sub_resource type="StyleBoxFlat" id="StyleBackground"]
bg_color = Color(0.09, 0.075, 0.065, 1)

[sub_resource type="StyleBoxFlat" id="StyleArena"]
bg_color = Color(0.16, 0.14, 0.115, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.3, 0.22, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="Combat" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_combat")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBackground")

[node name="Page" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Page"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Page/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Page/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.82, 0.46, 1)
theme_override_font_sizes/font_size = 26
text = "BATTLE"

[node name="SpeedDownButton" type="Button" parent="Page/VBox/Header"]
custom_minimum_size = Vector2(42, 42)
layout_mode = 2
text = "−"

[node name="SpeedLabel" type="Label" parent="Page/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.75, 0.8, 1)
text = "SPEED  x1"

[node name="SpeedUpButton" type="Button" parent="Page/VBox/Header"]
custom_minimum_size = Vector2(42, 42)
layout_mode = 2
text = "+"

[node name="MenuButton" type="Button" parent="Page/VBox/Header"]
custom_minimum_size = Vector2(100, 42)
layout_mode = 2
text = "MENU"

[node name="BattleArea" type="VBoxContainer" parent="Page/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Arena" type="PanelContainer" parent="Page/VBox/BattleArea"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/panel = SubResource("StyleArena")

[node name="CombatSession" parent="Page/VBox/BattleArea/Arena" instance=ExtResource("2_session")]
unique_name_in_owner = true
layout_mode = 2

[node name="Footer" type="HBoxContainer" parent="Page/VBox"]
layout_mode = 2

[node name="Hint" type="Label" parent="Page/VBox/Footer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.52, 0.5, 0.46, 1)
text = "Esc: menu    - / =: speed    Click a unit: details"

[node name="RestartButton" type="Button" parent="Page/VBox/Footer"]
custom_minimum_size = Vector2(130, 48)
layout_mode = 2
text = "RESTART"

[node name="ManagementButton" type="Button" parent="Page/VBox/Footer"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
disabled = true
text = "CONTINUE"

[node name="PlayerStatistics" parent="." instance=ExtResource("4_statistics")]
unique_name_in_owner = true
layout_mode = 1
anchor_top = 0.1
anchor_bottom = 0.433333
offset_left = 24.0
offset_right = 284.0
grow_vertical = 2

[node name="EnemyStatistics" parent="." instance=ExtResource("4_statistics")]
unique_name_in_owner = true
layout_mode = 1
anchor_left = 1.0
anchor_top = 0.1
anchor_right = 1.0
anchor_bottom = 0.433333
offset_left = -284.0
offset_right = -24.0
grow_horizontal = 0
grow_vertical = 2

[node name="SelectedUnitPanel" parent="." instance=ExtResource("5_selected")]
unique_name_in_owner = true
layout_mode = 1
anchor_left = 0.15
anchor_top = 1.0
anchor_right = 0.85
anchor_bottom = 1.0
offset_top = -262.0
offset_bottom = -78.0
grow_horizontal = 2
grow_vertical = 0

[node name="PostBattlePanel" parent="." instance=ExtResource("3_post_battle")]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -380.0
offset_top = -260.0
offset_right = 380.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2

[connection signal="pressed" from="Page/VBox/Header/SpeedDownButton" to="." method="_on_speed_down_button_pressed"]
[connection signal="pressed" from="Page/VBox/Header/SpeedUpButton" to="." method="_on_speed_up_button_pressed"]
[connection signal="pressed" from="Page/VBox/Header/MenuButton" to="." method="_on_menu_button_pressed"]
[connection signal="pressed" from="Page/VBox/Footer/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Page/VBox/Footer/ManagementButton" to="." method="_on_management_button_pressed"]
