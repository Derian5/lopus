[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/post_battle/post_battle_panel.gd" id="1_panel"]

[sub_resource type="StyleBoxFlat" id="StylePanel"]
bg_color = Color(0.045, 0.052, 0.068, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.55, 0.45, 0.24, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="PostBattlePanel" type="PanelContainer"]
custom_minimum_size = Vector2(760, 520)
theme_override_styles/panel = SubResource("StylePanel")
script = ExtResource("1_panel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 22

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ResultTitle" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.82, 0.46, 1)
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="DurationLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.69, 0.76, 1)
horizontal_alignment = 1

[node name="RewardLabel" type="Label" parent="Margin/VBox"]
