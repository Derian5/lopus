theme_override_font_sizes/font_size = 18
text = "GOLD  +0"
horizontal_alignment = 1

[node name="DetailsScroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Details" type="VBoxContainer" parent="Margin/VBox/DetailsScroll"]
layout_mode = 2
size_flags_horizontal = 3
