layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Margin/VBox/DetailsScroll/Details/Metrics/DamageBox"]
layout_mode = 2
text = "TOP DAMAGE"
horizontal_alignment = 1

[node name="TopDamageValue" type="Label" parent="Margin/VBox/DetailsScroll/Details/Metrics/DamageBox"]
unique_name_in_owner = true
