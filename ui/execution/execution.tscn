[gd_scene format=3]

[ext_resource type="Script" path="res://ui/execution/execution.gd" id="1"]

[ext_resource type="Script" path="res://ui/common/screen_backdrop.gd" id="10_backdrop"]

[sub_resource type="StyleBoxFlat" id="Panel"]
bg_color = Color(0.095, 0.028, 0.035, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.68, 0.2, 0.16, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
shadow_color = Color(0, 0, 0, 0.72)
shadow_size = 14
corner_detail = 1
content_margin_top = 10.0
content_margin_bottom = 10.0

[node name="Execution" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("10_backdrop")
mouse_filter = 2
accent_color = Color(0.62, 0.3, 0.3, 1)
horizon = -1.0

[node name="Page" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 22

[node name="VBox" type="VBoxContainer" parent="Page"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Page/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Page/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 34
text = "THE PRICE OF VICTORY"
theme_type_variation = &"TitleLabel"

[node name="MenuButton" type="Button" parent="Page/VBox/Header"]
custom_minimum_size = Vector2(96, 40)
layout_mode = 2
text = "MENU"

[node name="Sentence" type="PanelContainer" parent="Page/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("Panel")

[node name="Label" type="Label" parent="Page/VBox/Sentence"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.42, 1)
theme_override_font_sizes/font_size = 20
text = "VICTORY HAS A PRICE. THE STRONGEST WILL PAY IT."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Instructions" type="Label" parent="Page/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.74, 0.7, 0.74, 1)
text = "One Hero stands closest to the crown. The other two will not let them reach it. Select the favorite to reveal the betrayal."
horizontal_alignment = 1
autowrap_mode = 2
theme_type_variation = &"MutedLabel"
visible = true

[node name="CardsScroll" type="ScrollContainer" parent="Page/VBox"]
layout_mode = 2
size_flags_vertical = 3
vertical_scroll_mode = 0

[node name="HeroCards" type="HBoxContainer" parent="Page/VBox/CardsScroll"]
unique_name_in_owner = true
custom_minimum_size = Vector2(970, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 28
alignment = 1

[node name="FeedbackLabel" type="Label" parent="Page/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.67, 0.32, 1)
text = ""
horizontal_alignment = 1
autowrap_mode = 2

[node name="ExecuteButton" type="Button" parent="Page/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
disabled = true
text = "SET THE BETRAYAL IN MOTION"
theme_type_variation = &"DangerButton"
theme_override_font_sizes/font_size = 20

[node name="ConfirmationOverlay" type="Control" parent="."]
unique_name_in_owner = true
visible = false
z_index = 90
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0

[node name="Dimmer" type="ColorRect" parent="ConfirmationOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.008, 0.004, 0.004, 0.82)

[node name="Center" type="CenterContainer" parent="ConfirmationOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="ConfirmationPanel" type="PanelContainer" parent="ConfirmationOverlay/Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(640, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="ConfirmationOverlay/Center/ConfirmationPanel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="ConfirmationOverlay/Center/ConfirmationPanel/Content"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0.76, 0.61, 0.38, 1)
theme_override_font_sizes/font_size = 24
text = "THE PRICE OF VICTORY"
horizontal_alignment = 1

[node name="CondemnedName" type="Label" parent="ConfirmationOverlay/Center/ConfirmationPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0.95, 0.42, 0.31, 1)
theme_override_font_sizes/font_size = 36
text = "THE FAVORITE"
horizontal_alignment = 1

[node name="Sentence" type="Label" parent="ConfirmationOverlay/Center/ConfirmationPanel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.76, 0.69, 0.59, 1)
theme_override_font_sizes/font_size = 19
text = "One step from the crown.\nOne betrayal from the grave."
horizontal_alignment = 1

[node name="ConfirmationBody" type="Label" parent="ConfirmationOverlay/Center/ConfirmationPanel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 0.81, 0.71, 1)
theme_override_font_sizes/font_size = 18
text = "Their fate is sealed."
horizontal_alignment = 1
autowrap_mode = 2

[node name="AcceptPriceButton" type="Button" parent="ConfirmationOverlay/Center/ConfirmationPanel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 56)
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"DangerButton"
theme_override_font_sizes/font_size = 20
text = "SUCH IS THE PRICE"

[node name="CutsceneOverlay" type="Control" parent="."]
unique_name_in_owner = true
visible = false
z_index = 100
