[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/execution/execution.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.025, 0.02, 0.026, 1)

[sub_resource type="StyleBoxFlat" id="Panel"]
bg_color = Color(0.085, 0.045, 0.05, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.68, 0.2, 0.16, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="Execution" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Background")

[node name="Page" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 22

[node name="VBox" type="VBoxContainer" parent="Page"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Page/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Page/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.96, 0.72, 0.35, 1)
theme_override_font_sizes/font_size = 28
text = "THE PRICE OF VICTORY"

[node name="MenuButton" type="Button" parent="Page/VBox/Header"]
custom_minimum_size = Vector2(96, 40)
layout_mode = 2
text = "MENU"

[node name="Sentence" type="PanelContainer" parent="Page/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("Panel")

[node name="Label" type="Label" parent="Page/VBox/Sentence"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.42, 1)
theme_override_font_sizes/font_size = 20
text = "THE IRON WARDEN HAS FALLEN. ONE HERO MUST BE LEFT BEHIND."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Instructions" type="Label" parent="Page/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.74, 0.7, 0.74, 1)
text = "Compare every permanent loss before choosing. Alive and Dead Heroes are eligible. The decision cannot be reversed through Resurrection, UI, or Save/Load."
horizontal_alignment = 1
autowrap_mode = 2

[node name="CardsScroll" type="ScrollContainer" parent="Page/VBox"]
layout_mode = 2
size_flags_vertical = 3
vertical_scroll_mode = 0

[node name="HeroCards" type="HBoxContainer" parent="Page/VBox/CardsScroll"]
unique_name_in_owner = true
custom_minimum_size = Vector2(970, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="FeedbackLabel" type="Label" parent="Page/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.67, 0.32, 1)
text = "Select the Hero whose build will be sealed in the run history."
horizontal_alignment = 1
autowrap_mode = 2

[node name="ExecuteButton" type="Button" parent="Page/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
disabled = true
text = "CHOOSE HERO FOR EXECUTION"

[node name="ConfirmationDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Irreversible Execution"
ok_button_text = "EXECUTE HERO"
cancel_button_text = "GO BACK"

[connection signal="pressed" from="Page/VBox/Header/MenuButton" to="." method="_on_menu_pressed"]
[connection signal="pressed" from="Page/VBox/ExecuteButton" to="." method="_on_execute_pressed"]
[connection signal="confirmed" from="ConfirmationDialog" to="." method="_on_execution_confirmed"]
