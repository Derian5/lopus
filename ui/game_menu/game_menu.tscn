[gd_scene format=3]

[ext_resource type="Script" path="res://ui/game_menu/game_menu.gd" id="1_game_menu"]

[ext_resource type="Script" path="res://ui/common/ornate_frame.gd" id="10_frame"]

[sub_resource type="StyleBoxFlat" id="StyleDim"]
bg_color = Color(0.008, 0.01, 0.015, 0.82)

[node name="GameMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
script = ExtResource("1_game_menu")

[node name="Dim" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleDim")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(380, 340)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 42
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 42
theme_override_constants/margin_bottom = 36

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "MENU"
horizontal_alignment = 1
theme_type_variation = &"HeaderLabel"

[node name="Spacer" type="Control" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2

[node name="ResumeButton" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "RESUME"
theme_type_variation = &"PrimaryButton"

[node name="MainMenuButton" type="Button" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "MAIN MENU"
theme_type_variation = &"LedgerButton"

[node name="QuitButton" type="Button" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "QUIT"
theme_type_variation = &"LedgerButton"

[node name="Hint" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.55, 0.63, 1)
theme_override_font_sizes/font_size = 18
text = "Press Esc to resume"
horizontal_alignment = 1
visible = false

[node name="Ornament" type="Control" parent="Center/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("10_frame")
accent_color = Color(0.86, 0.68, 0.32, 1)
glow = 0.25
pulse = true
inset = -14.0
crest_width = 90.0
corner_gem = &"gold"
side_notches = true

[connection signal="pressed" from="Center/Panel/Margin/VBox/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/QuitButton" to="." method="_on_quit_button_pressed"]
