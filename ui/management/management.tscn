[node name="FightButton" type="Button" parent="Page/VBox/Footer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 54)
layout_mode = 2
text = "START BATTLE"

[connection signal="pressed" from="Page/VBox/Header/MenuButton" to="." method="_on_menu_button_pressed"]
[connection signal="pressed" from="Page/VBox/Footer/FightButton" to="." method="_on_fight_button_pressed"]
