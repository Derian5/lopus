[gd_scene format=3]

[ext_resource type="Script" path="res://ui/run_outcome/run_outcome.gd" id="1"]

[ext_resource type="Script" path="res://ui/common/ornate_frame.gd" id="10_frame"]

[ext_resource type="Script" path="res://ui/common/screen_backdrop.gd" id="11_backdrop"]

[node name="RunOutcome" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("11_backdrop")
horizon = -1.0

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(620, 430)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 54
theme_override_constants/margin_bottom = 48

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Eyebrow" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.55, 0.4, 1)
theme_override_font_sizes/font_size = 16
text = "THE ARMY HAS FALLEN"
horizontal_alignment = 1
theme_type_variation = &"EyebrowLabel"

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.82, 0.45, 1)
theme_override_font_sizes/font_size = 38
text = "RUN DEFEAT"
horizontal_alignment = 1
theme_type_variation = &"TitleLabel"

[node name="Body" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.72, 0.77, 0.85, 1)
text = "The campaign has ended."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="NewRunButton" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "START NEW RUN"
theme_type_variation = &"PrimaryButton"

[node name="MainMenuButton" type="Button" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "MAIN MENU"
theme_type_variation = &"LedgerButton"

[node name="StatusLabel" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.45, 0.35, 1)
horizontal_alignment = 1

[node name="Ornament" type="Control" parent="Center/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("10_frame")
accent_color = Color(0.86, 0.3, 0.24, 1)
glow = 0.4
pulse = true
inset = -14.0
crest_width = 110.0
corner_gem = &"red"
side_notches = true

[connection signal="pressed" from="Center/Panel/Margin/VBox/NewRunButton" to="." method="_on_new_run_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/MainMenuButton" to="." method="_on_main_menu_pressed"]
